file(MAKE_DIRECTORY "${WORK_DIR}")
file(REMOVE "${WORK_DIR}/main.obj" "${WORK_DIR}/twice.obj" "${WORK_DIR}/occupied.bin"
            "${WORK_DIR}/alias-input.asm"
            "${WORK_DIR}/alias.obj" "${WORK_DIR}/alias.bin" "${WORK_DIR}/dangling.bin"
            "${WORK_DIR}/no-output.obj" "${WORK_DIR}/no-output.bin"
            "${WORK_DIR}/linked.obj" "${WORK_DIR}/linked.bin")

function(check expected_status message_pattern tool)
    execute_process(COMMAND "${tool}" ${ARGN}
        WORKING_DIRECTORY "${WORK_DIR}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status STREQUAL expected_status)
        message(FATAL_ERROR "${tool} ${ARGN} returned ${status}, expected ${expected_status}\n${errors}")
    endif()
    if(expected_status STREQUAL "0")
        if(NOT output MATCHES "${message_pattern}" OR NOT errors STREQUAL "")
            message(FATAL_ERROR "Unexpected success output: ${output}\n${errors}")
        endif()
    elseif(NOT errors MATCHES "${message_pattern}" OR NOT output STREQUAL "")
        message(FATAL_ERROR "Unexpected failure output: ${output}\n${errors}")
    endif()
endfunction()

check(0 "SICXEObjectAssembler SOURCE" "${ASSEMBLER}" --help)
check(0 "--relocatable.*--absolute" "${LINKER}" -h)
check(2 "Uso:" "${ASSEMBLER}")
check(2 "Uso:" "${ASSEMBLER}" one.asm two.asm)
check(2 "Uso:" "${ASSEMBLER}" one.asm -o --output)
check(2 "Uso:" "${ASSEMBLER}" one.asm -o no-output.obj --output second.obj)
check(2 "Uso:" "${LINKER}")
check(2 "Uso:" "${LINKER}" --absolute 0x100)
check(2 "Uso:" "${LINKER}" --absolute -1 main.obj)
check(2 "Uso:" "${LINKER}" --absolute 0x main.obj)
check(2 "Uso:" "${LINKER}" --absolute 0x100g main.obj)
check(2 "Uso:" "${LINKER}" --absolute 4294967296 main.obj)
check(2 "Uso:" "${LINKER}" --relocatable main.obj --absolute 0x100)
check(2 "Uso:" "${LINKER}" --relocatable main.obj -o no-output.obj -o second.obj)

file(WRITE "${WORK_DIR}/invalid.asm" " LDA #1\n END\n")
file(WRITE "${WORK_DIR}/invalid.obj" "HMAIN  000000000001\nT00000001GG\nE\n")
check(1 "invalid.asm:1:[0-9]+: error" "${ASSEMBLER}" invalid.asm -o no-output.obj)
check(1 "missing.asm: error" "${ASSEMBLER}" missing.asm -o no-output.obj)
check(1 "invalid.obj:2:10: error" "${LINKER}" --relocatable invalid.obj -o no-output.obj)
check(1 "missing.obj: error" "${LINKER}" --absolute 0 missing.obj -o no-output.bin)
check(1 "Entrada precisa ser um arquivo regular" "${LINKER}" --relocatable . -o no-output.obj)

check(0 "Objeto:" "${ASSEMBLER}" "${FIXTURES}/main.asm" -o main.obj)
check(0 "Objeto:" "${ASSEMBLER}" "${FIXTURES}/twice.asm" -o twice.obj)
file(READ "${WORK_DIR}/main.obj" original)
check(1 "main.obj:.*TWICE" "${LINKER}" --relocatable main.obj -o no-output.obj)
check(1 "main.obj:.*MAIN" "${LINKER}" --relocatable main.obj main.obj -o no-output.obj)
check(1 "espaco de carga" "${LINKER}" --absolute 0xFFFFF main.obj twice.obj -o no-output.bin)
check(1 "espaco de carga" "${LINKER}" --absolute 0x100000 main.obj twice.obj -o no-output.bin)
check(1 "preparar a saida" "${LINKER}" --relocatable main.obj twice.obj -o no-directory/output.obj)
check(1 "preparar a saida" "${ASSEMBLER}" "${FIXTURES}/main.asm" -o no-directory/output.obj)

file(WRITE "${WORK_DIR}/occupied.bin" "keep existing bytes")
configure_file("${FIXTURES}/main.asm" "${WORK_DIR}/alias-input.asm" COPYONLY)
file(READ "${WORK_DIR}/alias-input.asm" source)
check(1 "Saida ja existe" "${LINKER}" --absolute 0 main.obj twice.obj -o occupied.bin)
check(1 "Saida ja existe" "${LINKER}" --relocatable main.obj twice.obj -o ./main.obj)
check(1 "Saida ja existe" "${ASSEMBLER}" alias-input.asm -o ./alias-input.asm)
file(READ "${WORK_DIR}/main.obj" preserved)
file(READ "${WORK_DIR}/occupied.bin" occupied)
file(READ "${WORK_DIR}/alias-input.asm" preserved_source)
if(NOT preserved STREQUAL original OR NOT occupied STREQUAL "keep existing bytes"
        OR NOT preserved_source STREQUAL source)
    message(FATAL_ERROR "A failure overwrote an existing file")
endif()

file(CREATE_LINK "${WORK_DIR}/main.obj" "${WORK_DIR}/alias.obj" RESULT hardlink)
if(hardlink STREQUAL "0")
    check(1 "Saida ja existe" "${LINKER}" --relocatable main.obj twice.obj -o alias.obj)
    file(READ "${WORK_DIR}/alias.obj" alias_contents)
    if(NOT alias_contents STREQUAL original)
        message(FATAL_ERROR "The hard-linked input was changed")
    endif()
endif()
file(CREATE_LINK "${WORK_DIR}/main.obj" "${WORK_DIR}/alias.bin" SYMBOLIC RESULT symlink)
if(symlink STREQUAL "0")
    check(1 "Saida ja existe" "${LINKER}" --absolute 0 main.obj twice.obj -o alias.bin)
endif()
file(CREATE_LINK "${WORK_DIR}/missing-target.bin" "${WORK_DIR}/dangling.bin" SYMBOLIC RESULT dangling)
if(dangling STREQUAL "0")
    check(1 "Saida ja existe" "${LINKER}" --absolute 0 main.obj twice.obj -o dangling.bin)
endif()

foreach(file no-output.obj no-output.bin linked.obj linked.bin second.obj missing-target.bin no-directory)
    if(EXISTS "${WORK_DIR}/${file}" OR IS_SYMLINK "${WORK_DIR}/${file}")
        message(FATAL_ERROR "A failure left ${file} behind")
    endif()
endforeach()
file(GLOB staging "${WORK_DIR}/.sicxe-stage-*")
if(staging)
    message(FATAL_ERROR "A failure left staged files behind: ${staging}")
endif()
